/* subpackages/order-list/list.wxss — 对齐微信订单列表规范 */

.page {
  min-height: 100vh;
  background: #ededed;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Tab：顶栏白底 + 下划线指示 */
.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.tab {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1;
}

.tab.on .tab-text {
  color: rgba(0, 0, 0, 0.9);
  font-weight: 600;
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  background: var(--xo-green, #6ec73b);
  border-radius: 3rpx;
}

.tab-badge {
  margin-left: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #fa5151;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
}

.body {
  padding: 16rpx 0 0;
}

/* 订单卡片：白底圆角，卡片间距 */
.order {
  margin: 0 24rpx 16rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.order-hover {
  background: #f7f7f7;
}

.order-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.order-no {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-st {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
}

.order-bd {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.order-stage {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
}

.order-amt {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.amt-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
}

.amt-num {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  font-variant-numeric: tabular-nums;
}

.order-next {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.8);
}

.order-cd {
  font-size: 24rpx;
  color: #ff8f00;
}

.order-todo {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.8);
}

/* 操作区：右对齐，主次按钮区分 */
.order-ft {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 24rpx;
}

.btn-plain,
.btn-main {
  min-width: 144rpx;
  height: 56rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.btn-plain {
  color: rgba(0, 0, 0, 0.8);
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.15);
}

.btn-hover {
  background: #f2f2f2;
}

.btn-main {
  color: #fff;
  background: var(--xo-green, #6ec73b);
  border: 1rpx solid var(--xo-green, #6ec73b);
}

.btn-main-hover {
  opacity: 0.88;
}

.empty {
  margin: 120rpx 48rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-t {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.8);
  font-weight: 500;
}

.empty-d {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: center;
  line-height: 1.5;
}

.empty-btn {
  margin-top: 40rpx;
  min-width: 200rpx;
  height: 72rpx;
  font-size: 28rpx;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.35);
}

/* subpackages/user-center/center.wxss — 对齐微信「我」页 */

.page {
  min-height: 100vh;
  background: #ededed;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding: 36rpx 32rpx;
  background: #fff;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f2f2f2;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--xo-green, #6ec73b);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

.profile-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.desc {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.group {
  margin-bottom: 16rpx;
  background: #fff;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.cell:last-child {
  border-bottom: none;
}

.cell-hover {
  background: #ececec;
}

.cell-title {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.9);
  flex-shrink: 0;
}

.cell-extra {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  max-width: 62%;
}

.cell-value {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-value.green {
  color: #2f6b1a;
}

.cell-action {
  font-size: 26rpx;
  color: var(--xo-green, #6ec73b);
  flex-shrink: 0;
}

.arrow {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.25);
  line-height: 1;
  flex-shrink: 0;
}

.addr {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.addr-t {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
  font-weight: 500;
}

.addr-d {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
  line-height: 1.45;
}

.form {
  padding-bottom: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.field-l {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
}

.field-i {
  flex: 1;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
  text-align: right;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 28rpx 32rpx;
}

.btn-plain,
.btn-main {
  min-width: 144rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-plain {
  color: rgba(0, 0, 0, 0.8);
  border: 1rpx solid rgba(0, 0, 0, 0.15);
  background: #fff;
}

.btn-hover {
  background: #f2f2f2;
}

.btn-main {
  color: #fff;
  background: var(--xo-green, #6ec73b);
  border: 1rpx solid var(--xo-green, #6ec73b);
}

.btn-main-hover {
  opacity: 0.88;
}

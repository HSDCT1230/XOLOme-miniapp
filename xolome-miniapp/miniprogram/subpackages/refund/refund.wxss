/* subpackages/refund/refund.wxss — 退款申请 */

.page-refund {
  min-height: 100vh;
  background: var(--xo-canvas);
  padding-bottom: 200rpx;
}

/* === 退款金额展示 === */
.amount-hero {
  background: var(--xo-ink);
  padding: 60rpx 32rpx 48rpx;
  text-align: center;
}

.hero-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

.hero-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 20rpx 0;
}

.hero-symbol {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
  margin-right: 6rpx;
}

.hero-value {
  font-size: 80rpx;
  color: #fff;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.hero-status {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
}

/* === 通用 section === */
.section {
  margin: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 0;
  border-left: none;
}

/* === 订单信息卡片 === */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid var(--xo-line);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  font-family: -apple-system, monospace;
}

/* === 退款规则 === */
.rules-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid var(--xo-line);
}

.rule-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--xo-line-2);
}

.rule-row:last-child {
  border-bottom: none;
}

.rule-label {
  font-size: 26rpx;
  color: #666;
}

.rule-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
}

.rule-value-highlight {
  font-size: 32rpx;
  color: #fff;
  font-weight: 800;
}

/* === 退款原因 === */
.reason-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--xo-line);
}

.reason-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.reason-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.reason-count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* === 温馨提示 === */
.tips-card {
  margin: 24rpx;
  padding: 28rpx 32rpx;
  background: rgba(255,143,0,0.1);
  border-radius: 16rpx;
  border-left: 6rpx solid #ff8f00;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

.tips-contact {
  color: #6ec73b;
}

/* === 底部按钮栏 === */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 10;
}

.btn-back {
  flex: 1;
  margin-right: 20rpx;
  border-color: #ddd;
  color: #666;
}

.btn-confirm {
  flex: 2;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

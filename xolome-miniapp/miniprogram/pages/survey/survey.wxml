<!--pages/survey/survey.wxml — 问卷页-->
<wxs module="helper">
function ansOf(answers, qid) {
  if (!answers) return null;
  var key = '' + qid;
  if (answers[key] !== undefined && answers[key] !== null) return answers[key];
  return null;
}
function isRadioChecked(answers, qid, val) {
  return ansOf(answers, qid) === val;
}
function isChecked(answers, qid, val) {
  var arr = ansOf(answers, qid);
  if (!arr || !arr.length) return false;
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === val) return true;
  }
  return false;
}
module.exports = { isChecked: isChecked, isRadioChecked: isRadioChecked };
</wxs>

<view class="page-survey">
  <view class="progress-bar-wrap">
    <view class="survey-banner">约 2–4 分钟 · 提交后发 ¥500 券</view>
    <view class="progress-info">
      <text class="progress-step">{{currentStep + 1}} / {{totalSteps}}</text>
      <text class="progress-percent">{{progressPercent}}%</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <view class="question-area">
    <view class="question-card" wx:if="{{currentQuestion}}">
      <view class="question-title">
        <text class="q-index">{{currentQuestion.badge || currentQuestion.id}}</text>
        <text class="q-text">{{currentQuestion.title}}</text>
        <text class="q-required" wx:if="{{currentQuestion.required}}">*</text>
      </view>
      <view class="q-hint" wx:if="{{currentQuestion.hint}}">{{currentQuestion.hint}}</view>

      <!-- 单选：整行可点，避免原生 radio 受控回弹 -->
      <view wx:if="{{currentQuestion.type === 'radio'}}" class="options">
        <view
          wx:for="{{currentQuestion.options}}"
          wx:key="value"
          class="option-item {{helper.isRadioChecked(answers, currentQuestion.id, item.value) ? 'option-active' : ''}}"
          data-qid="{{currentQuestion.id}}"
          data-value="{{item.value}}"
          data-type="radio"
          bindtap="onTapOption"
        >
          <view class="option-mark radio {{helper.isRadioChecked(answers, currentQuestion.id, item.value) ? 'on' : ''}}">
            <view wx:if="{{helper.isRadioChecked(answers, currentQuestion.id, item.value)}}" class="radio-dot"></view>
          </view>
          <text class="option-label">{{item.label}}</text>
        </view>
      </view>

      <!-- 多选 -->
      <view wx:if="{{currentQuestion.type === 'checkbox'}}" class="options">
        <view
          wx:for="{{currentQuestion.options}}"
          wx:key="value"
          class="option-item {{helper.isChecked(answers, currentQuestion.id, item.value) ? 'option-active' : ''}}"
          data-qid="{{currentQuestion.id}}"
          data-value="{{item.value}}"
          data-type="checkbox"
          bindtap="onTapOption"
        >
          <view class="option-mark check {{helper.isChecked(answers, currentQuestion.id, item.value) ? 'on' : ''}}">
            <text wx:if="{{helper.isChecked(answers, currentQuestion.id, item.value)}}" class="check-icon">✓</text>
          </view>
          <text class="option-label">{{item.label}}</text>
        </view>
      </view>

      <view class="text-input-wrap" wx:if="{{currentQuestion.type === 'text'}}">
        <textarea
          class="text-input"
          data-qid="{{currentQuestion.id}}"
          value="{{answers[currentQuestion.id]}}"
          placeholder="{{currentQuestion.placeholder}}"
          placeholder-class="input-placeholder"
          maxlength="300"
          auto-height
          bindinput="onTextInput"
        />
        <view class="input-counter">{{answers[currentQuestion.id] ? answers[currentQuestion.id].length : 0}}/300</view>
      </view>
    </view>

    <view class="question-card" wx:if="{{nextQuestion}}">
      <view class="question-title">
        <text class="q-index">{{nextQuestion.badge || nextQuestion.id}}</text>
        <text class="q-text">{{nextQuestion.title}}</text>
        <text class="q-required" wx:if="{{nextQuestion.required}}">*</text>
      </view>
      <view class="q-hint" wx:if="{{nextQuestion.hint}}">{{nextQuestion.hint}}</view>

      <view class="text-input-wrap">
        <textarea
          class="text-input"
          data-qid="{{nextQuestion.id}}"
          value="{{answers[nextQuestion.id]}}"
          placeholder="{{nextQuestion.placeholder}}"
          placeholder-class="input-placeholder"
          maxlength="300"
          auto-height
          bindinput="onTextInput"
        />
        <view class="input-counter">{{answers[nextQuestion.id] ? answers[nextQuestion.id].length : 0}}/300</view>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="btn btn-outline btn-prev {{isFirstStep ? 'btn-disabled' : ''}}" bindtap="onPrev">
      上一题
    </view>
    <view wx:if="{{!isLastStep}}" class="btn btn-primary btn-next" bindtap="onNext">
      下一题
    </view>
    <view
      wx:if="{{isLastStep}}"
      class="btn btn-primary btn-submit {{submitting ? 'btn-disabled' : ''}}"
      bindtap="onSubmit"
    >
      {{submitting ? '提交中...' : '提交问卷'}}
    </view>
  </view>
</view>

/* pages/index/index.wxss — 首页层次与冲击力 */

.page-index {
  min-height: 100vh;
  background: var(--xo-canvas);
}

/* ===== Hero ===== */
.hero {
  position: relative;
  width: 100%;
  height: 640rpx;
  overflow: hidden;
  background: #050505;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero-bg {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-vignette {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: radial-gradient(
    ellipse 90% 70% at 70% 35%,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.35) 100%
  );
  pointer-events: none;
}

.hero-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(5, 5, 5, 0) 0%,
    rgba(5, 5, 5, 0.55) 42%,
    rgba(5, 5, 5, 0.92) 100%
  );
  pointer-events: none;
}

.hero-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 40rpx 44rpx;
  z-index: 3;
  pointer-events: none;
}

.logo-img {
  width: 300rpx;
  height: 90rpx;
  display: block;
}

.product-subtitle {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
  max-width: 620rpx;
}

.product-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.55;
  max-width: 580rpx;
}

.hero-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
}

.hero-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  transition: width 0.28s ease, background 0.28s ease;
}

.hero-dot-on {
  width: 32rpx;
  background: var(--xo-green);
}

/* ===== 库存深色带 ===== */
.stock-band {
  margin: 0;
  padding: 28rpx 40rpx 24rpx;
  background: #111;
  color: #fff;
}

.stock-band-inner {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
}

.stock-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stock-kicker {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #ff8f00;
}

.stock-label {
  font-size: 30rpx;
  color: #fff;
  font-weight: 800;
}

.stock-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.stock-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff595f;
  font-family: var(--xo-font-num);
  margin-right: 6rpx;
}

.stock-track {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
}

.stock-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--xo-green-deep), var(--xo-green-light));
  border-radius: 999rpx;
  transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}

.stock-sold {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ===== 区块标题 ===== */
.block {
  margin: 0;
  padding: 56rpx 40rpx 8rpx;
}

.block-head {
  margin-bottom: 36rpx;
}

.block-kicker {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--xo-green-deep);
  margin-bottom: 10rpx;
}

.block-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--xo-ink);
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.block-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--xo-ink-3);
  line-height: 1.5;
}

.block-head-light .block-kicker {
  color: var(--xo-green);
}

.block-head-light .block-title {
  color: #fff;
}

.block-head-light .block-sub {
  color: rgba(255, 255, 255, 0.55);
}

/* ===== 核心体验 · 图文卡片 ===== */
.block-features {
  background: var(--xo-canvas);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.feature-card {
  overflow: hidden;
}

.feature-media {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #1a1a1a;
}

.feature-img {
  width: 100%;
  height: 100%;
  display: block;
}

.feature-media-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 100%);
  pointer-events: none;
}

.feature-index {
  position: absolute;
  left: 24rpx;
  bottom: 20rpx;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 800;
  font-family: var(--xo-font-num);
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.feature-body {
  padding: 20rpx 4rpx 0;
}

.feature-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.feature-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--xo-ink);
}

.feature-tag {
  font-size: 20rpx;
  color: var(--xo-green-deep);
  letter-spacing: 2rpx;
  font-weight: 600;
}

.feature-desc {
  font-size: 26rpx;
  color: var(--xo-ink-2);
  line-height: 1.65;
}

/* DIY 体验入口（置顶） */
.diy-entry {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--xo-ink);
  border-radius: 16rpx;
}

.diy-entry-top {
  margin-top: 28rpx;
}

.diy-entry:active {
  opacity: 0.92;
}

.diy-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.diy-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--xo-green);
}

.diy-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.35;
}

.diy-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.45;
}

.diy-btn {
  flex-shrink: 0;
  padding: 22rpx 28rpx;
  background: var(--xo-green);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

/* ===== 联名深色区 ===== */
.collab-band {
  margin-top: 48rpx;
  padding: 56rpx 40rpx 48rpx;
  background: #111;
}

.poster-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.poster {
  width: 100%;
  display: block;
  border-radius: 12rpx;
  overflow: hidden;
  background: #1a1a1a;
  vertical-align: top;
}

/* 联名展台横滑 */
.showcase-head {
  margin: 36rpx 0 16rpx;
}

.showcase-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.showcase-scroll {
  width: 100%;
  white-space: nowrap;
}

.showcase-track {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 8rpx;
}

.showcase-card {
  flex-shrink: 0;
  width: 520rpx;
  overflow: hidden;
  background: transparent;
}

.showcase-img {
  width: 520rpx;
  height: 348rpx;
  display: block;
  border-radius: 12rpx;
  background: #222;
}

.showcase-meta {
  padding: 16rpx 4rpx 0;
}

.showcase-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
}

.showcase-partner {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0.5rpx;
}

/* ===== 服务入口：并列 ===== */
.service-panel {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.service-panel-row {
  display: flex;
  align-items: stretch;
}

.service-cell {
  flex: 1;
  min-width: 0;
  padding: 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.service-hover {
  background: #ececec;
}

.service-divider {
  width: 1rpx;
  margin: 28rpx 0;
  background: rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.service-title {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.9);
  font-weight: 600;
}

.service-value {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== CTA · 双按钮可点 ===== */
.bottom-space {
  height: 200rpx;
}

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
}

.cta {
  position: relative;
  flex: 1;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.cta:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.cta-ghost {
  background: #ff8f00;
}

.cta-ghost .cta-main {
  color: #fff;
}

.cta-ghost .cta-sub {
  color: rgba(255, 255, 255, 0.88);
}

.cta-solid {
  background: var(--xo-green);
}

.cta-solid .cta-main {
  color: #fff;
}

.cta-solid .cta-sub {
  color: rgba(255, 255, 255, 0.9);
}

.cta-main {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.cta-sub {
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1.2;
}

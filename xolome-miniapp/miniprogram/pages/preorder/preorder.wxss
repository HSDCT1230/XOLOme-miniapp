/* pages/preorder/preorder.wxss — 预订单页（XOLO 品牌风 · 全色板） */

.page-preorder {
  min-height: 100vh;
  background: var(--xo-canvas);
  padding-bottom: 40rpx;
}

/* === 优惠券横幅 === */
.coupon-banner {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--xo-ink);
  border-radius: 16rpx;
}
.coupon-icon { font-size: 40rpx; margin-right: 20rpx; }
.coupon-info { flex: 1; min-width: 0; }
.coupon-title { font-size: 28rpx; font-weight: 700; color: #fff; margin-bottom: 6rpx; }
.coupon-desc { font-size: 22rpx; color: rgba(255,255,255,0.6); }

/* === 价值主张 === */
.value-banner {
  margin: 24rpx 32rpx 0;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid var(--xo-line);
  text-align: left;
}
.value-banner .value-tag {
  display: inline-block;
  padding: 0;
  background: none;
  border-radius: 0;
  font-size: 22rpx;
  color: var(--xo-green-deep);
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.value-banner .value-line {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--xo-ink);
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.value-banner .value-sub {
  font-size: 24rpx;
  color: var(--xo-ink-3);
  letter-spacing: 1rpx;
}

/* === 金额颜色 === */
.c-coupon { color: var(--xo-green-deep); font-weight: 600; }

/* === 通用 section === */
.section { margin: 24rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xo-ink);
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid var(--xo-accent, var(--xo-green));
}
.section-title.blue   { --xo-accent: var(--xo-blue); }
.section-title.purple { --xo-accent: var(--xo-purple); }

/* === 时间轴（三阶段：绿/蓝/橙 数据驱动） === */
.timeline {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid var(--xo-line);
}
.timeline-item { display: flex; align-items: flex-start; }
.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.timeline-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.12), inset 0 0 0 4rpx rgba(255,255,255,0.35);
}
.timeline-line {
  width: 2rpx;
  flex: 1;
  min-height: 60rpx;
  background: var(--xo-line);
  margin: 12rpx 0;
}
.timeline-content { flex: 1; padding-bottom: 32rpx; min-width: 0; }
.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.timeline-stage { font-size: 30rpx; font-weight: 700; color: var(--xo-ink); }
.timeline-amount { font-size: 30rpx; font-weight: 800; color: var(--xo-green-deep); }
.timeline-desc { font-size: 26rpx; color: var(--xo-ink-2); margin-bottom: 8rpx; }
.timeline-refund {
  font-size: 22rpx;
  color: var(--xo-green-deep);
  background: rgba(110,199,59,0.10);
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--xo-r-pill);
}

/* === 金额明细 === */
.amount-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid var(--xo-line);
}
.amount-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; }
.amount-label { font-size: 28rpx; color: var(--xo-ink-2); }
.amount-value { font-size: 28rpx; color: var(--xo-ink); font-weight: 600; }
.amount-divider { height: 1rpx; background: var(--xo-line); margin: 16rpx 0; }
.amount-retail .amount-label { color: var(--xo-ink-4); }
.amount-strike { color: var(--xo-ink-4); text-decoration: line-through; font-weight: 400; }
.amount-total { padding: 20rpx 0 8rpx; }
.amount-total .amount-label { font-size: 32rpx; font-weight: 700; color: var(--xo-ink); }
.amount-highlight { font-size: 44rpx; font-weight: 800; color: var(--xo-red); }
.amount-saved {
  text-align: right;
  font-size: 24rpx;
  color: var(--xo-red);
  font-weight: 600;
  margin-top: 8rpx;
}

/* === 退款规则卡片 === */
.rule-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid var(--xo-line);
}
.rule-item { margin-bottom: 24rpx; }
.rule-item:last-of-type { margin-bottom: 16rpx; }
.rule-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--xo-r-pill);
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}
.rule-tag-green  { background: rgba(110,199,59,0.12);  color: var(--xo-green-deep); }
.rule-tag-cyan   { background: rgba(69,137,214,0.14);  color: var(--xo-blue); }
.rule-tag-purple { background: rgba(114,78,155,0.14);  color: var(--xo-purple); }
.rule-text { font-size: 26rpx; color: var(--xo-ink-2); line-height: 1.6; }
.rule-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--xo-green-deep);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--xo-line);
}

/* === 协议勾选 === */
.agreement-section { margin: 24rpx; padding: 24rpx; }
.agreement-check { display: flex; align-items: flex-start; }
.checkbox {
  width: 40rpx; height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 10rpx;
  margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: all 0.2s;
}
.checkbox-checked { background: var(--xo-green); border-color: var(--xo-green); }
.checkbox-icon { color: #fff; font-size: 28rpx; font-weight: 700; }
.agreement-text { font-size: 26rpx; color: var(--xo-ink-2); line-height: 1.6; flex: 1; padding-top: 4rpx; }
.agreement-link { color: var(--xo-green-deep); font-weight: 600; }

/* === 底部占位 === */
.bottom-placeholder { height: 180rpx; }

/* === 底部支付按钮 === */
.pay-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.94);
  border-top: 1rpx solid var(--xo-line);
}
.pay-info { flex: 1; }
.pay-amount { font-size: 40rpx; font-weight: 800; color: var(--xo-ink); }
.pay-tip { font-size: 22rpx; color: var(--xo-ink-3); margin-top: 4rpx; }
.pay-btn {
  padding: 0 48rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--xo-green);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--xo-sh-green);
  transition: transform 0.2s ease, opacity 0.2s ease;
}
.pay-btn:active { transform: scale(0.97); opacity: 0.85; }
.pay-btn-disabled { opacity: 0.45; pointer-events: none; box-shadow: none; }

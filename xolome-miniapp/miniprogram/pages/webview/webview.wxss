/* pages/webview/webview.wxss */
page {
  background: #111;
  color: #fff;
}

.fallback {
  min-height: 100vh;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 28rpx;
}

.fallback-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.fallback-desc {
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
}

.fallback-url {
  font-size: 24rpx;
  color: #6ec73b;
  word-break: break-all;
}

.fallback-actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  background: #6ec73b;
  color: #111;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

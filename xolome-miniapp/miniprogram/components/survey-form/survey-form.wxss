.survey-form {
  padding: 28rpx 0;
}

/* 题目 */
.question-title {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.q-index {
  font-size: 32rpx;
  font-weight: 700;
  color: #6ec73b;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.q-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.5;
}

/* 选项 */
.options {
  display: flex;
  flex-direction: column;
}

.option-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--xo-canvas);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.option-card.selected {
  background: rgba(110, 199, 59, 0.12);
  border-color: #6ec73b;
}

/* 单选圆点 */
.option-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid #ccc;
  background: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.2s;
}

.option-radio.radio-on {
  border-color: #6ec73b;
  background: #6ec73b;
  position: relative;
}

.option-radio.radio-on::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
  transform: translate(-50%, -50%);
}

/* 多选方框 */
.option-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 4rpx solid #ccc;
  background: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.option-checkbox.checkbox-on {
  border-color: #6ec73b;
  background: #6ec73b;
}

.checkmark {
  width: 12rpx;
  height: 20rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg) translate(-2rpx, -2rpx);
}

.option-label {
  font-size: 28rpx;
  color: #333;
}

.option-card.selected .option-label {
  color: #6ec73b;
  font-weight: 600;
}

/* 文本输入 */
.text-wrap {
  width: 100%;
}

.text-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--xo-canvas);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.text-input:focus {
  border-color: #6ec73b;
}

.input-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.voucher-card {
  position: relative;
  display: flex;
  align-items: stretch;
  background: linear-gradient(135deg, #6ec73b 0%, #724e9b 50%, #8fdf5a 100%);
  border-radius: 20rpx;
  overflow: hidden;
  margin: 20rpx 24rpx;
  min-height: 180rpx;
  box-shadow: 0 6rpx 20rpx rgba(114, 78, 155, 0.3);
}

/* === 左侧面额 === */
.voucher-left {
  flex: 0 0 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
}

.amount-symbol {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.amount-value {
  font-size: 76rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
}

.amount-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* === 中间圆孔虚线分隔 === */
.voucher-separator {
  position: relative;
  width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.notch {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: var(--xo-canvas);
  border-radius: 50%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}

.notch-top {
  top: -14rpx;
}

.notch-bottom {
  bottom: -14rpx;
}

.dashed-line {
  flex: 1;
  width: 0;
  border-left: 2rpx dashed rgba(255, 255, 255, 0.45);
  margin: 14rpx 0;
}

/* === 右侧信息 === */
.voucher-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 28rpx;
  min-width: 0;
}

.source-tag {
  display: inline-flex;
  align-self: flex-start;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.validity-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.validity-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-right: 8rpx;
}

.validity-date {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.voucher-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* === 状态水印 === */
.voucher-watermark {
  position: absolute;
  top: 50%;
  right: 40rpx;
  transform: translateY(-50%) rotate(-18deg);
  font-size: 52rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.22);
  pointer-events: none;
  z-index: 3;
  letter-spacing: 4rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.22);
  padding: 4rpx 20rpx;
  border-radius: 8rpx;
}
